{
  "ReverseProxy": {
    "Routes": {
      "usuario-route": {
        "ClusterId": "usuario-cluster",
        "Match": {
          "Path": "/usuarios/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/usuarios"
          }
        ]
      },
      "jogo-route": {
        "ClusterId": "jogo-cluster",
        "Match": {
          "Path": "/jogos/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/jogos"
          }
        ]
      },
      "pagamento-route": {
        "ClusterId": "pagamento-cluster",
        "Match": {
          "Path": "/pagamentos/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/pagamentos"
          }
        ]
      }
    },
    "Clusters": {
      "usuario-cluster": {
        "Destinations": {
          "usuario-destination": {
            "Address": "http://usuarioservice:8080/"
          }
        }
      },
      "jogo-cluster": {
        "Destinations": {
          "jogo-destination": {
            "Address": "http://jogoservice:8080/"
          }
        }
      },
      "pagamento-cluster": {
        "Destinations": {
          "pagamento-destination": {
            "Address": "http://pagamentoservice:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}